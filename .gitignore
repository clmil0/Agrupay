Claude outputs/

# macOS
.DS_Store

# Xcode · estado del IDE
# Cambia al desplazarte, al abrir una pestaña o al poner un punto de parada, así
# que ensucia cada commit con ruido binario que no le dice nada a nadie más.
# Los esquemas están marcados como compartidos y Xcode los regenera solo al
# clonar, así que aquí no se pierde ninguno.
xcuserdata/
*.xcuserstate

# Xcode · productos de compilación
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Carpeta local de Wrangler al publicar web/
web/.wrangler/
web
output
Tarjetas_referencia

# Credenciales. Las funciones de Supabase leen todo de variables de entorno
# (ver supabase/functions), y la clave de APNs no debe salir de tu máquina.
*.p8
.env
.env.*
!.env.example

